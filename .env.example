# Public site URL. Use http://localhost:3000 locally and your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=

# Supabase Connect dialog values. Required for admin authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Not required for the admin-auth phase; never expose it to browser code.
SUPABASE_SECRET_KEY=

# Cloudinary page-image and moderated guest-photo storage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-only HMAC secret used to anonymize guest-upload device/IP rate keys. Minimum 32 characters.
UPLOAD_RATE_LIMIT_SECRET=
